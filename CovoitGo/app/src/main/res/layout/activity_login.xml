<?xml version="1.0" encoding="utf-8"?>
<!-- Maquette 6 : connexion -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="64dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Logo CovoitGo"
                android:src="@drawable/ic_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="CovoitGo"
                android:textColor="@color/rouge"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                style="@style/SousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="40dp"
                android:text="Le covoiturage réservé aux étudiants" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-mail de l'établissement"
                android:textColor="@color/texte"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/ChampConnexion"
                android:autofillHints="emailAddress"
                android:hint="prenom.nom@esprit.tn"
                android:inputType="textEmailAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mot de passe"
                android:textColor="@color/texte"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMotDePasse"
                style="@style/ChampConnexion"
                android:layout_marginBottom="4dp"
                android:autofillHints="password"
                android:hint="Mot de passe"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/tvMotDePasseOublie"
                style="@style/Lien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Mot de passe oublié ?" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConnexion"
                style="@style/BoutonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="Se connecter" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="48dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal">

                <TextView
                    style="@style/SousTitre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pas encore de compte ? " />

                <TextView
                    android:id="@+id/tvInscription"
                    style="@style/Lien"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Créer un compte" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
