<?xml version="1.0" encoding="utf-8"?>
<!-- Maquette 1 : accueil / recherche -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- En-tete : logo + profil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Logo"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="CovoitGo"
                    android:textColor="@color/rouge"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnProfil"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_rond_bordure"
                    android:contentDescription="Profil"
                    android:src="@drawable/ic_profil" />
            </LinearLayout>

            <TextView
                style="@style/TitreEcran"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Où allez-vous aujourd'hui ?" />

            <TextView
                style="@style/SousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="16dp"
                android:text="Covoiturage entre étudiants d'Esprit" />

            <!-- Carte de recherche -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_carte"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Départ" android:src="@drawable/ic_depart" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Départ" />

                        <EditText
                            android:id="@+id/etDepart"
                            style="@style/Valeur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Ezzahra, Manouba, Mégrine…"
                            android:inputType="textCapWords"
                            android:maxLines="1" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnEchanger"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_rond_bordure"
                        android:contentDescription="Inverser départ et arrivée"
                        android:src="@drawable/ic_echanger" />
                </LinearLayout>

                <View style="@style/Separateur" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Arrivée" android:src="@drawable/ic_lieu" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arrivée" />

                        <EditText
                            android:id="@+id/etArrivee"
                            style="@style/Valeur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Esprit · El Ghazala"
                            android:inputType="textCapWords"
                            android:maxLines="1"
                            android:text="Esprit · El Ghazala" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Separateur" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/zoneDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Date" android:src="@drawable/ic_calendrier" />

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Date" />
                            <TextView android:id="@+id/tvDate" style="@style/Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Aujourd'hui" />
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/gris_clair" />

                    <LinearLayout
                        android:id="@+id/zonePlaces"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Places" android:src="@drawable/ic_profil" />

                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
                            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Places" />
                            <TextView android:id="@+id/tvPlaces" style="@style/Valeur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 passager" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechercher"
                    style="@style/BoutonPrincipal"
                    android:layout_width="match_parent"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="Rechercher" />
            </LinearLayout>

            <!-- Trajets frequents -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:paddingStart="16dp"
                android:text="Trajets fréquents"
                android:textColor="@color/texte"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Etiquette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="16dp"
                android:text="Aller vers Esprit" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/listeAller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <TextView
                style="@style/Etiquette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingStart="16dp"
                android:text="Retour depuis Esprit" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/listeRetour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp" />
            </HorizontalScrollView>

            <!-- Bandeau conducteur -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_carte_beige"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vous avez une voiture ?"
                        android:textColor="@color/texte"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Publiez votre trajet et partagez les frais."
                        android:textColor="@color/texte_doux"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPublierBandeau"
                    style="@style/BoutonNoir"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Publier" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barre_navigation" />
</LinearLayout>
