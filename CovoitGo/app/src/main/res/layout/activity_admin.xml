<?xml version="1.0" encoding="utf-8"?>
<!-- Espace administrateur : valider les conducteurs, traiter les reclamations -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="12dp">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="Logo" android:src="@drawable/ic_logo" />
        <TextView style="@style/TitreEcran" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Administration" android:textSize="24sp" />
        <TextView android:id="@+id/tvDeconnexion" style="@style/Lien" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="Déconnexion" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="4dp">
        <TextView android:id="@+id/ongletConducteurs" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_segment_actif" android:gravity="center" android:text="Conducteurs" android:textColor="@color/texte" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/ongletReclamations" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Réclamations" android:textColor="@color/texte_doux" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:visibility="gone" />
    <TextView android:id="@+id/tvVide" style="@style/SousTitre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp" android:visibility="gone" />

    <ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:divider="@android:color/transparent" android:dividerHeight="12dp" android:paddingStart="12dp" android:paddingTop="16dp" android:paddingEnd="12dp" android:paddingBottom="16dp" />
</LinearLayout>
