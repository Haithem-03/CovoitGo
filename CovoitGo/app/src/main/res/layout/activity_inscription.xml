<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageButton
                android:id="@+id/btnRetour"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rond_bordure"
                android:contentDescription="Retour"
                android:src="@drawable/ic_retour" />

            <TextView
                style="@style/TitreEcran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Créer un compte" />

            <TextView
                style="@style/SousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Réservé aux étudiants avec une adresse @esprit.tn" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nom" />
            <EditText android:id="@+id/etNom" style="@style/ChampConnexion" android:hint="Nom" android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prénom" />
            <EditText android:id="@+id/etPrenom" style="@style/ChampConnexion" android:hint="Prénom" android:inputType="textPersonName|textCapWords" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="E-mail de l'établissement" />
            <EditText android:id="@+id/etEmail" style="@style/ChampConnexion" android:hint="prenom.nom@esprit.tn" android:inputType="textEmailAddress" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Téléphone" />
            <EditText android:id="@+id/etTelephone" style="@style/ChampConnexion" android:hint="8 chiffres" android:inputType="phone" android:maxLength="8" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mot de passe" />
            <EditText android:id="@+id/etMotDePasse" style="@style/ChampConnexion" android:hint="6 caractères minimum" android:inputType="textPassword" />

            <TextView style="@style/Etiquette" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confirmer le mot de passe" />
            <EditText android:id="@+id/etConfirmation" style="@style/ChampConnexion" android:hint="Mot de passe" android:inputType="textPassword" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInscrire"
                style="@style/BoutonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="Créer mon compte" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
